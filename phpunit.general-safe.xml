<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheResult="false">
 <testsuites>
  <testsuite name="GeneralSafeMemory">
   <directory>tests/Unit</directory>
   <directory>tests/Feature</directory>
   <exclude>tests/Feature/OrganisationApiTest.php</exclude>
   <exclude>tests/Feature/ParametrageSecurityTest.php</exclude>
   <exclude>tests/Feature/ParametrageJournalTest.php</exclude>
   <exclude>tests/Feature/ParametrageIntegrationTest.php</exclude>
   <exclude>tests/Feature/NetworkValidationTest.php</exclude>
   <exclude>tests/Feature/NotificationsApiTest.php</exclude>
   <exclude>tests/Feature/ReferenceCatalogParametrageTest.php</exclude>
   <exclude>tests/Feature/TransportApiTest.php</exclude>
   <exclude>tests/Feature/DemandeServiceApiTest.php</exclude>
   <exclude>tests/Feature/ResourceProfileApiTest.php</exclude>
   <exclude>tests/Feature/TreatmentCourseApiTest.php</exclude>
  </testsuite>
 </testsuites>
 <groups><exclude><group>mysql</group></exclude></groups>
 <php>
  <env name="APP_ENV" value="testing" force="true"/>
  <env name="DB_CONNECTION" value="sqlite" force="true"/>
  <env name="DB_DATABASE" value=":memory:" force="true"/>
  <env name="DB_URL" value="" force="true"/>
  <env name="CACHE_STORE" value="array" force="true"/>
  <env name="SESSION_DRIVER" value="array" force="true"/>
  <env name="QUEUE_CONNECTION" value="sync" force="true"/>
  <env name="MAIL_MAILER" value="array" force="true"/>
  <env name="LOG_CHANNEL" value="null" force="true"/>
  <env name="BCRYPT_ROUNDS" value="4" force="true"/>
 </php>
</phpunit>
